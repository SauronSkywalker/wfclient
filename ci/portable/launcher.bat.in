@echo off
setlocal EnableDelayedExpansion
rem PORTABLE-LAUNCHER @STAMP@
rem
rem THIS GENERATION'S LAUNCHER.  Its file name carries the pack timestamp, so
rem the next release is a DIFFERENT file and can never overwrite a batch file
rem that a console is running -- that was how an "updated" client kept running
rem the old code.
rem
rem The three big folders are named after their content (python-<h> / src-<h> /
rem engine-<h>); which one runs is decided by lines 1 and 2 of current.txt.  The
rem two defaults below are only for a folder that has not been installed yet,
rem and point at the generations this package was built with.
rem
rem ASCII ONLY: cmd reads a .bat in the OEM codepage, so utf8 chinese here is
rem mis-parsed.  All user-facing text belongs in the client's log.
set "PYDIR=@PY@"
set "SRCDIR=@SRC@"
if exist "%~dp0current.txt" (
  set "N=0"
  for /f "usebackq delims=" %%L in ("%~dp0current.txt") do (
    set /a N+=1
    set "L!N!=%%L"
  )
  if not "!L1!"=="" set "PYDIR=!L1!"
  if not "!L2!"=="" set "SRCDIR=!L2!"
)
cd /d "%~dp0"
set "PYTHONIOENCODING=utf-8"
set "PYTHONNOUSERSITE=1"
"%~dp0!PYDIR!\python.exe" -B "%~dp0!SRCDIR!\app.py"
echo.
echo ---- exited with code %ERRORLEVEL% ----
pause
