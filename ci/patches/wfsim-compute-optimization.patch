+/// A FIGHT PREPARED ONCE AND RUN MANY TIMES — everything a SHARD wants, and
+/// nothing a report does.
+///
+/// THE PER-RUN COST IS THE SETUP, not the run. `ready` parses the fight,
+/// resolves the build, seats the whole roster and applies every term to build
+/// `FightParams`; `fight::shard` then plays one run through it. A board row is
+/// FOLDED ONE RUN A PIECE (`board_rows::fold_runs` — nothing coarser
+/// reproduces the number), so going through `simulate_shard_json` in that loop
+/// paid the whole setup again, and a JSON trip, for every run of the row.
+///
+/// THE ANSWER CANNOT MOVE. The same `params`, the same `seed` and the same
+/// `(from, count)` reach the same `fight::shard`/`fight::shard_onto`, and the
+/// accumulator keeps the run order the fold had.
+pub struct Prepared {
+    params: Arc<wfsim_engine::fight::FightParams>,
+    seed: u64,
+    want_series: bool,
+}
+
+impl Prepared {
+
+    /// ONE SHARD A RUN, ACROSS THREADS, in index order — for a caller that has
+    /// cores of its own and no fleet to spend them on.
+    pub fn shards_threaded(
+        &self,
+        from: u32,
+        count: u32,
+        threads: usize,
+    ) -> Vec<wfsim_engine::fight::Shard> {
+        wfsim_engine::fight::shards_parallel(
+            Arc::clone(&self.params), from, count, self.seed, self.want_series, threads,
+        )
+    }
+
+    /// …AND THOSE RUNS FOLDED IN RUN ORDER — `shard_onto` to the bit.
+    pub fn fold_threaded(
+        &self,
+        acc: wfsim_engine::fight::Shard,
+        from: u32,
+        count: u32,
+        threads: usize,
+    ) -> wfsim_engine::fight::Shard {
+        wfsim_engine::fight::fold_parallel(
+            Arc::clone(&self.params), acc, from, count, self.seed, self.want_series, threads,
+        )
+    }
+}
+
+/// READY A FIGHT FOR ITS RUNS — `ready` without the report, for a caller that
+/// will run many shards of one request.
+pub fn prepare(v: &Value) -> Result<Prepared, Value> {
+    let Ready { fight, params, .. } = ready(v, false)?;
+    Ok(Prepared {
+        params: Arc::new(params),
+        seed: fight.seed,
+        want_series: get_bool(v, "run_series", false),
+    })
+}
