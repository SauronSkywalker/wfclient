+/// ONE SHARD A RUN, ACROSS THREADS — the same runs the serial fold walks, and
+/// in the same order, so the fold that follows is the serial one to the bit.
+///
+/// A run's dice are a pure function of `(seed, index)` (`shard_onto`), so a run
+/// is independent of every other one; the order they are COMPUTED in never
+/// mattered, only the order they are ADDED. That is the whole licence for this
+/// function: it returns the runs as separate shards, in index order, and the
+/// caller adds them one at a time exactly as the serial fold would have.
+///
+/// WASM HAS NO THREADS (`docs/WASM.md` phase 3 — the page's own fleet is what
+/// it has instead), so the same signature is serial there.
+type PoolJob = Box<dyn FnOnce() + Send + 'static>;
+
+struct WorkerPool {
+    senders: Vec<mpsc::Sender<PoolJob>>,
+    next: AtomicUsize,
+    _workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+impl WorkerPool {
+    fn new(threads: usize) -> Arc<Self> {
+        let threads = threads.max(1);
+        let mut senders = Vec::with_capacity(threads);
+        let mut workers = Vec::with_capacity(threads);
+        for _ in 0..threads {
+            let (tx, rx) = mpsc::channel::<PoolJob>();
+            senders.push(tx);
+            workers.push(std::thread::spawn(move || {
+                while let Ok(job) = rx.recv() {
+                    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(job));
+                }
+            }));
+        }
+        Arc::new(Self { senders, next: AtomicUsize::new(0), _workers: workers })
+    }
+
+    fn submit(&self, job: PoolJob) {
+        let i = self.next.fetch_add(1, Ordering::Relaxed) % self.senders.len();
+        let _ = self.senders[i].send(job);
+    }
+}
+
+fn pool_for(threads: usize) -> Arc<WorkerPool> {
+    static POOLS: OnceLock<Mutex<HashMap<usize, Arc<WorkerPool>>>> = OnceLock::new();
+    let pools = POOLS.get_or_init(|| Mutex::new(HashMap::new()));
+    let mut map = pools.lock().unwrap();
+    let threads = threads.max(1);
+    map.entry(threads)
+        .or_insert_with(|| WorkerPool::new(threads))
+        .clone()
+}
+
+/// ONE SHARD A RUN, ACROSS A PERSISTENT POOL — the same runs the serial fold
+/// walks, and in the same order, so the fold that follows is the serial one to
+/// the bit.  An atomic index gives the next free worker the next run; the
+/// result vector is filled by index, so only WHERE a run was fought changes,
+/// never the order the shards are merged.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn shards_parallel(
+    params: Arc<FightParams>,
+    from: u32,
+    count: u32,
+    seed: u64,
+    keep: bool,
+    threads: usize,
+) -> Vec<Shard> {
+    let n = count as usize;
+    let lanes = threads.max(1).min(n.max(1));
+    if lanes <= 1 {
+        return (0..n)
+            .map(|i| shard(params.as_ref(), from + i as u32, 1, seed, keep, &mut |_| {}))
+            .collect();
+    }
+    let next = Arc::new(AtomicUsize::new(0));
+    let (tx, rx) = mpsc::channel::<Vec<(usize, Shard)>>();
+    let pool = pool_for(lanes);
+    for _ in 0..lanes {
+        let params = Arc::clone(&params);
+        let next = Arc::clone(&next);
+        let tx = tx.clone();
+        pool.submit(Box::new(move || {
+            let mut found = Vec::new();
+            loop {
+                let i = next.fetch_add(1, Ordering::Relaxed);
+                if i >= n {
+                    break;
+                }
+                found.push((i, shard(
+                    params.as_ref(), from + i as u32, 1, seed, keep, &mut |_| {},
+                )));
+            }
+            let _ = tx.send(found);
+        }));
+    }
+    drop(tx);
+    let mut out: Vec<Option<Shard>> = (0..n).map(|_| None).collect();
+    for _ in 0..lanes {
+        match rx.recv() {
+            Ok(batch) => {
+                for (i, s) in batch {
+                    out[i] = Some(s);
+                }
+            }
+            Err(_) => break,
+        }
+    }
+    out.into_iter().map(|x| x.expect("every run is fought")).collect()
+}
+
+/// …AND THE SAME, SERIAL, where there are no threads to have.
+#[cfg(target_arch = "wasm32")]
+pub fn shards_parallel(
+    params: Arc<FightParams>,
+    from: u32,
+    count: u32,
+    seed: u64,
+    keep: bool,
+    _threads: usize,
+) -> Vec<Shard> {
+    (0..count as usize)
+        .map(|i| shard(params.as_ref(), from + i as u32, 1, seed, keep, &mut |_| {}))
+        .collect()
+}
+
+/// …AND THE FOLD, THREADED: fight the runs in parallel, then add them in RUN
+/// ORDER.  Floating-point addition is not associative, so the order the
+/// marginals are merged in is part of the answer — and it is the one
+/// `shard_onto` uses.  One lane is `shard_onto` itself.
+pub fn fold_parallel(
+    params: Arc<FightParams>,
+    acc: Shard,
+    from: u32,
+    count: u32,
+    seed: u64,
+    keep: bool,
+    threads: usize,
+) -> Shard {
+    if threads <= 1 {
+        return shard_onto(params.as_ref(), acc, from, count, seed, keep, &mut |_| {});
+    }
+    let mut acc = acc;
+    for s in shards_parallel(Arc::clone(&params), from, count, seed, keep, threads) {
+        acc.merge(&s);
+    }
+    acc
+}
