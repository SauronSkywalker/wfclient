+    #[test]
+    fn a_paused_start_does_not_build_a_report_even_if_a_later_start_clears_pending() {
+        struct Deferred {
+            missed: AtomicBool,
+            waiting: AtomicBool,
+            reports: std::sync::atomic::AtomicUsize,
+        }
+        impl QuickSpace for Deferred {
+            type Build = [Option<u8>; 3];
+            fn positions(&self, b: &Self::Build) -> Vec<Position> { Digits.positions(b) }
+            fn empty(&self, b: &Self::Build) -> Vec<Position> { Digits.empty(b) }
+            fn candidates(&self, b: &Self::Build, p: Position) -> Vec<Self::Build> { Digits.candidates(b, p) }
+            fn legal(&self, b: &Self::Build) -> bool { Digits.legal(b) }
+            fn key(&self, b: &Self::Build) -> String { Digits.key(b) }
+            fn score(&self, bs: &[Self::Build]) -> Vec<Score> {
+                let known = bs.iter().all(|b| *b == [Some(0); 3]);
+                self.missed.store(!known, Ordering::Relaxed);
+                if !known { self.waiting.store(true, Ordering::Relaxed); }
+                if known { Digits.score(bs) } else { vec![None; bs.len()] }
+            }
+            fn pending(&self) -> bool { self.missed.load(Ordering::Relaxed) }
+            fn has_pending_work(&self) -> bool { self.waiting.load(Ordering::Relaxed) }
+            fn identity(&self, b: &Self::Build) -> String {
+                self.reports.fetch_add(1, Ordering::Relaxed);
+                self.key(b)
+            }
+        }
+        let space = Deferred { missed: AtomicBool::new(false), waiting: AtomicBool::new(false), reports: Default::default() };
+        let starts = vec![
+            QuickStart { build: [None; 3], fixed: vec![], unnamed: vec![] },
+            QuickStart { build: [Some(0); 3], fixed: Digits.positions(&[Some(0); 3]), unnamed: vec![] },
+        ];
+        let cfg = QuickConfig { max_evals: 0, stop: Vec::new() };
+        let result = quick_descent(&space, &starts, &cfg);
+        assert!(!space.pending(), "the last start cleared the last-call flag");
+        assert_eq!(result.progress.len(), 2, "all starts still get a turn");
+        assert!(!result.progress[0].settled);
+        assert!(result.progress[1].settled);
+        assert_eq!(space.reports.load(Ordering::Relaxed), 0, "no discarded report is materialized");
+        assert!(result.answers.is_empty());
+        assert!(result.pool.is_empty());
+        // A previous call's last-score flag must not discard this call's
+        // completed answer when an illegal first start never asks for a score.
+        let space = Deferred { missed: AtomicBool::new(true), waiting: AtomicBool::new(false), reports: Default::default() };
+        let starts = vec![
+            QuickStart { build: [Some(9); 3], fixed: Digits.positions(&[Some(9); 3]), unnamed: vec![] },
+            QuickStart { build: [Some(0); 3], fixed: Digits.positions(&[Some(0); 3]), unnamed: vec![] },
+        ];
+        let result = quick_descent(&space, &starts, &cfg);
+        assert_eq!(result.failures.len(), 1);
+        assert_eq!(result.answers.len(), 1);
+        assert_eq!(result.answers[0].build, [Some(0); 3]);
+    }
