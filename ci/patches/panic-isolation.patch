-/// SHARD METERING, for `WFSIM_PHASE_TRACE` and nothing else.
-///
-/// The row's own trace says how long the fold took; it does not say how big a
-/// window the fold held open.  These counters answer that — how many shards the
-/// lanes produced, how many the merger added, and the most that were ever in
-/// flight — which is the number the pipeline exists to bound.
-mod foldstats {
-    use std::sync::atomic::{AtomicU64, Ordering};
-
-    pub static PRODUCED: AtomicU64 = AtomicU64::new(0);
-    pub static MERGED: AtomicU64 = AtomicU64::new(0);
-    pub static PEAK: AtomicU64 = AtomicU64::new(0);
-
-    pub fn reset() {
-        PRODUCED.store(0, Ordering::Relaxed);
-        MERGED.store(0, Ordering::Relaxed);
-        PEAK.store(0, Ordering::Relaxed);
-    }
-
-    pub fn produced(n: u64) {
-        PRODUCED.fetch_add(n, Ordering::Relaxed);
-    }
-
-    pub fn merged(n: u64) {
-        let done = MERGED.fetch_add(n, Ordering::Relaxed) + n;
-        let live = PRODUCED.load(Ordering::Relaxed).saturating_sub(done);
-        PEAK.fetch_max(live, Ordering::Relaxed);
-    }
-
-    pub fn snapshot() -> (u64, u64, u64) {
-        (PRODUCED.load(Ordering::Relaxed), MERGED.load(Ordering::Relaxed),
-         PEAK.load(Ordering::Relaxed))
-    }
-}
