-/// …AND THE SAME, SERIAL, where there are no threads to have.
-#[cfg(target_arch = "wasm32")]
-pub fn shards_parallel(
-    params: Arc<FightParams>,
-    from: u32,
-    count: u32,
-    seed: u64,
-    keep: bool,
-    _threads: usize,
-) -> Vec<Shard> {
-    (0..count as usize)
-        .map(|i| shard(params.as_ref(), from + i as u32, 1, seed, keep, &mut |_| {}))
