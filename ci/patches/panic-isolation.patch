+            a.add(*b);
+        }
+        for (a, b) in self.by_combatant.iter_mut().zip(&o.by_combatant) {
+            *a += *b;
+        }
+        for (a, b) in self.by_body.iter_mut().zip(&o.by_body) {
+            *a += b;
+        }
+        self.index.extend_from_slice(&o.index);
+        self.series.kill_progress.extend_from_slice(&o.series.kill_progress);
+        self.series.effective.extend_from_slice(&o.series.effective);
+    }
+}
+
+/// One run's contribution, in one place — so the shard loop and nothing else
+/// knows how a `RunResult` becomes a total.
+pub(super) fn add_sources(acc: &mut SourceDamage, r: &SourceDamage) {
+    acc.direct += r.direct;
+    acc.radial += r.radial;
+    acc.field += r.field;
+    acc.arcane_on_status += r.arcane_on_status;
+    acc.extra_hit += r.extra_hit;
+    acc.syndicate += r.syndicate;
+    for (a, v) in acc.status.iter_mut().zip(r.status) {
+        *a += v;
+    }
+    for (a, v) in acc.extra_hit_by_type.iter_mut().zip(r.extra_hit_by_type) {
+        *a += v;
+    }
+    for (a, v) in acc.syndicate_by_type.iter_mut().zip(r.syndicate_by_type) {
+        *a += v;
+    }
+}
+
+/// The odd 64-bit constant SplitMix64 uses to walk its own state — reused here
+/// to spread consecutive run INDICES across the seed space, so run 0 and run 1
+/// are as unrelated as two arbitrary seeds.
+pub(super) const GOLDEN_GAP: u64 = 0x9E37_79B9_7F4A_7C15;
+
+pub(super) fn monte_carlo_inner(
+    params: &FightParams,
+    runs: u32,
+    seed: u64,
+    keep: bool,
+    on_run: &mut impl FnMut(u32),
+) -> (Summary, RunSeries) {
+    monte_carlo_range(params, 0, runs, seed, keep, on_run)
+}
+
+/// …A SLICE OF THEM, which is what a shard runs. `from` is the index of the
+/// first run, and every run's dice are a pure function of `(seed, index)` — so
+/// eight workers each taking an eighth produce exactly what one worker taking
+/// all of them would.
+pub(super) fn monte_carlo_range(
+    params: &FightParams,
+    from: u32,
+    runs: u32,
+    seed: u64,
+    keep: bool,
+    on_run: &mut impl FnMut(u32),
+) -> (Summary, RunSeries) {
+    let s = shard(params, from, runs, seed, keep, on_run);
+    s.finish(params, runs)
+}
+
+/// RUN A SLICE and hand back what it contributed — the shape a WORKER returns.
+///
+/// `from` is the index of the first run; every run's dice are a pure function
+/// of `(seed, index)`, so eight of these over disjoint slices merge into what
+/// one call over the whole range produces.
+pub fn shard(
+    params: &FightParams,
+    from: u32,
+    runs: u32,
+    seed: u64,
+    keep: bool,
+    on_run: &mut impl FnMut(u32),
+) -> Shard {
+    shard_onto(params, Shard::default(), from, runs, seed, keep, on_run)
+}
+
+/// …ADDED ONTO `a`, the shard of the runs before `from`. The accumulator walks
+/// the runs in the same order either way, so continuing a shard of runs 0..k
+/// with k..n is the shard of 0..n to the bit — what lets a longer measurement
+/// keep a shorter one's runs instead of fighting them again.
+pub fn shard_onto(
+    params: &FightParams,
+    mut a: Shard,
+    from: u32,
+    runs: u32,
+    seed: u64,
+    keep: bool,
+    on_run: &mut impl FnMut(u32),
+) -> Shard {
+    a.runs += runs;
+    let gas_before = super::gas::gas_now();
+    for i in from..from + runs {
+        // EACH RUN'S OWN DICE, derived from the fight's seed and the run's
+        // INDEX. It was one Rng chain threaded through every run, so run i
+        // depended on how many draws runs 0..i had consumed — which made a run
+        // impossible to start without replaying everything before it, and
+        // therefore impossible to shard.
+        //
+        // STILL REPRODUCIBLE, which is the promise that matters: the same seed
+        // and the same index give the same run, on any machine and in any
+        // order. What moved ONCE is the SAMPLE — measured at 0.001% to 0.09%
+        // across the three `one_fight` shapes, against a Monte-Carlo standard
+        // error of about 0.3% at a thousand runs. A different draw from the
+        // same distribution, smaller than the noise the board already lives
+        // with.
+        let state = seed ^ u64::from(i).wrapping_mul(GOLDEN_GAP);
+        let r = run_once(params, &mut Rng::new(state));
+        crate::alive::beat();
+        a.index.push(RunKey::new(params.sample_by.of(&r), state));
+        on_run(a.index.len() as u32);
+        if keep {
+            a.series.kill_progress.push(r.kill_progress);
+            a.series.effective.push(r.effective_damage());
+        }
+        a.sum += r.total_damage();
+        a.sum_sq += r.total_damage() * r.total_damage();
+        a.min = a.min.min(r.total_damage());
+        a.max = a.max.max(r.total_damage());
+        a.effective += r.effective_damage();
+        a.effective_sq += r.effective_damage() * r.effective_damage();
+        a.dot += r.tally.dot();
+        a.overkill += r.overkill;
+        a.spilled += r.spilled;
+        a.health_damage += r.health_damage;
+        a.virus_stack_health += r.virus_stack_health;
+        a.armor_left_health += r.armor_left_health;
+        a.procs += u64::from(r.procs);
+        a.hits += u64::from(r.hits);
+        a.body_shots += u64::from(r.body_shots);
+        a.field_ticks += u64::from(r.field_ticks);
+        a.dot_ticks += u64::from(r.dot_ticks);
+        a.reloads += u64::from(r.reloads);
+        a.picked_up_ammo += r.picked_up_ammo;
+        a.transforms += u64::from(r.transforms);
+        a.ghost_kills += u64::from(r.ghost_kills);
+        a.ghosts_peak = a.ghosts_peak.max(r.ghosts_peak);
+        a.kills += u64::from(r.kills);
+        a.kills_sq += u64::from(r.kills) * u64::from(r.kills);
+        a.kill_progress += r.kill_progress;
+        a.kill_progress_sq += r.kill_progress * r.kill_progress;
+        a.min_kills = a.min_kills.min(r.kills);
+        a.max_kills = a.max_kills.max(r.kills);
+        a.downtime += r.downtime_seconds;
+        a.first_magazine += r.first_magazine_damage;
+        a.max_hit_sum += r.tally.max_hit();
+        a.biggest = a.biggest.max(r.tally.max_hit());
+        if let Some(at) = r.first_kill_at {
+            a.ttks.push(at);
+        }
+        a.shots += u64::from(r.shots);
+        a.pellets += u64::from(r.pellets);
+        a.crits += u64::from(r.crits);
+        a.big_crits += u64::from(r.big_crits);
+        a.self_damage.merge(&r.self_damage);
+        a.crit_tier_sum += u64::from(r.crit_tier_sum);
+        a.headshots += u64::from(r.headshots);
+        add_sources(&mut a.sources, &r.sources);
+        for (acc, v) in a.seat_counters.iter_mut().zip(r.per_seat) {
+            acc.add(v);
+        }
+        for (acc, v) in a.by_combatant.iter_mut().zip(r.dealt.by_combatant().0) {
+            *acc += v;
+        }
+        for (acc, v) in a.by_body.iter_mut().zip(r.taken.by_body().0) {
+            *acc += v;
+        }
+    }
+    a.gas += super::gas::gas_now() - gas_before;
+    a
+}
+
+/// ONE SHARD A RUN, ACROSS THREADS — the same runs the serial fold walks, and
+/// in the same order, so the fold that follows is the serial one to the bit.
+///
+/// A run's dice are a pure function of `(seed, index)` (`shard_onto`), so a run
+/// is independent of every other one; the order they are COMPUTED in never
+/// mattered, only the order they are ADDED. That is the whole licence for this
+/// function: it returns the runs as separate shards, in index order, and the
+/// caller adds them one at a time exactly as the serial fold would have.
+///
+/// WASM HAS NO THREADS (`docs/WASM.md` phase 3 — the page's own fleet is what
+/// it has instead), so the same signature is serial there.
+#[cfg(not(target_arch = "wasm32"))]
+type PoolJob = Box<dyn FnOnce() + Send + 'static>;
+
+#[cfg(not(target_arch = "wasm32"))]
+struct WorkerPool {
+    senders: Vec<mpsc::Sender<PoolJob>>,
+    next: AtomicUsize,
+    _workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+impl WorkerPool {
+    fn new(threads: usize) -> Arc<Self> {
+        let threads = threads.max(1);
+        let mut senders = Vec::with_capacity(threads);
+        let mut workers = Vec::with_capacity(threads);
+        for _ in 0..threads {
+            let (tx, rx) = mpsc::channel::<PoolJob>();
+            senders.push(tx);
+            workers.push(std::thread::spawn(move || {
+                while let Ok(job) = rx.recv() {
+                    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(job));
+                }
+            }));
+        }
+        Arc::new(Self { senders, next: AtomicUsize::new(0), _workers: workers })
+    }
+
+    fn submit(&self, job: PoolJob) {
+        let i = self.next.fetch_add(1, Ordering::Relaxed) % self.senders.len();
+        let _ = self.senders[i].send(job);
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn pool_for(threads: usize) -> Arc<WorkerPool> {
+    static POOLS: OnceLock<Mutex<HashMap<usize, Arc<WorkerPool>>>> = OnceLock::new();
+    let pools = POOLS.get_or_init(|| Mutex::new(HashMap::new()));
+    let mut map = pools.lock().unwrap();
+    let threads = threads.max(1);
+    map.entry(threads)
+        .or_insert_with(|| WorkerPool::new(threads))
+        .clone()
+}
+
+/// WHETHER A PANIC IN A RUN UNWINDS, and therefore whether one bad run can be
+/// answered for instead of taking the engine with it.  A `panic = "abort"`
+/// build cannot: the first panic is `std::process::abort()`, and every run the
+/// row had in flight dies with it.  The client spawns one engine per request
+/// and `terminate()`s it, so what the page sees is a dead engine and a missing
+/// answer — not a failed run it could retry or report.
+///
+/// Read through `panic_isolation()` rather than the constant: the endpoint that
+/// publishes it must not be folded into a literal by an optimiser.
+pub const PANIC_ISOLATION: bool = cfg!(panic = "unwind");
+
+/// …AND THE SAME FLAG, ASKED THE WAY THE ENDPOINT ASKS IT.
+#[inline(never)]
+pub fn panic_isolation() -> bool {
+    PANIC_ISOLATION
+}
+
+/// A RUN THAT PANICKED, AS AN ANSWER RATHER THAN A DEAD PROCESS.
+///
+/// The engine's contract is that a fold is either the number the serial fold
+/// would have produced or an error the caller can report.  A panicking run used
+/// to be neither — it ended the process.  This is what a lane hands back now:
+/// which run, of which range, and what the panic said.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RunFailure {
+    /// The rows the fold was asked for: `from .. from + count`.
+    pub from: u32,
+    pub count: u32,
+    /// The run that panicked, as the caller's index (`from + i`).
+    pub run: u32,
+    pub seed: u64,
+    /// The panic's own text ("index out of bounds…", a `panic!("…")`, …).
+    pub message: String,
+}
+
+impl RunFailure {
+    /// The line a caller shows a user: which run, of which fold, and why.
+    pub fn describe(&self) -> String {
+        format!(
+            "run {} of {}..{} panicked: {}",
+            self.run,
+            self.from,
+            self.from as u64 + self.count as u64,
+            self.message
+        )
+    }
+}
+
+impl std::fmt::Display for RunFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.describe())
+    }
+}
+
+/// WHAT THE PANIC SAID.  `panic!` carries a `&'static str` or a `String`; a
+/// payload of any other type still says that a panic happened, and nothing more
+/// is read out of it than that.
+fn panic_text(err: &(dyn std::any::Any + Send)) -> String {
+    if let Some(s) = err.downcast_ref::<&'static str>() {
+        (*s).to_string()
+    } else if let Some(s) = err.downcast_ref::<String>() {
+        s.clone()
+    } else {
+        "a panic with no message".to_string()
+    }
+}
+
+/// THE FAILURE A RUN'S PANIC BECOMES.  `#[cold]`: this runs on the path that
+/// used to abort, and the hot loop never touches it.
+#[cold]
+fn run_failure(
+    err: &(dyn std::any::Any + Send),
+    from: u32,
+    count: u32,
+    run: u32,
+    seed: u64,
+) -> RunFailure {
+    RunFailure { from, count, run, seed, message: panic_text(err) }
+}
+
+/// ONE RUN, WITH ITS PANIC CAUGHT — the whole of the isolation.
+///
+/// The unwind stops here and becomes a value; the lane (or, on the one-lane
+/// path, the caller) carries on with the next run.  Nothing OUTSIDE a single
+/// run is caught: a panic in the merge, or in the params a caller built, is
+/// still the programmer error it always was.
+fn fight_guarded<F: Fn(u32, u64) -> Shard>(
+    fight: &F,
+    run: u32,
+    from: u32,
+    count: u32,
+    seed: u64,
+) -> Result<Shard, RunFailure> {
+    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| fight(run, seed))) {
+        Ok(s) => Ok(s),
+        Err(err) => Err(run_failure(&*err, from, count, run, seed)),
+    }
+}
+
+
+/// SHARD METERING, for `WFSIM_PHASE_TRACE` and nothing else.
+///
+/// The row's own trace says how long the fold took; it does not say how big a
+/// window the fold held open.  These counters answer that — how many shards the
+/// lanes produced, how many the merger added, and the most that were ever in
+/// flight — which is the number the pipeline exists to bound.
+///
+/// Counted only where there are lanes to meter: a wasm fold is serial, and a
+/// module that nothing reads there is a warning, not a feature.
+#[cfg(not(target_arch = "wasm32"))]
+mod foldstats {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    pub static PRODUCED: AtomicU64 = AtomicU64::new(0);
+    pub static MERGED: AtomicU64 = AtomicU64::new(0);
+    pub static PEAK: AtomicU64 = AtomicU64::new(0);
+
+    pub fn reset() {
+        PRODUCED.store(0, Ordering::Relaxed);
+        MERGED.store(0, Ordering::Relaxed);
+        PEAK.store(0, Ordering::Relaxed);
+    }
+
+    pub fn produced(n: u64) {
+        PRODUCED.fetch_add(n, Ordering::Relaxed);
+    }
+
+    pub fn merged(n: u64) {
+        let done = MERGED.fetch_add(n, Ordering::Relaxed) + n;
+        let live = PRODUCED.load(Ordering::Relaxed).saturating_sub(done);
+        PEAK.fetch_max(live, Ordering::Relaxed);
+    }
+
+    pub fn snapshot() -> (u64, u64, u64) {
+        (PRODUCED.load(Ordering::Relaxed), MERGED.load(Ordering::Relaxed),
+         PEAK.load(Ordering::Relaxed))
+    }
+}
+
+/// Is the phase trace on?  Read ONCE — a row must not pay a getenv for it.
+#[cfg(not(target_arch = "wasm32"))]
+fn phase_trace() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("WFSIM_PHASE_TRACE").is_some())
+}
+
+/// HOW MANY RUNS ONE POOL JOB HANDS OVER AT A TIME.
+///
+/// A chunk is the unit of both balancing and hand-off.  The rule the merger
+/// obeys is "add run i only after every run before i has been added", so a
+/// chunk that finishes early has to WAIT — which means the size of the wait
+/// queue, not the size of the row, is what bounds the shards in flight.  At
+/// roughly thirty chunks per lane a lane still gets plenty of chances to pick
+/// up the next chunk, so balance stays within a chunk or two.
+#[cfg(not(target_arch = "wasm32"))]
+fn chunk_for(n: usize, lanes: usize) -> usize {
+    ((n + lanes * 32 - 1) / (lanes * 32)).max(1)
+}
+
+/// ONE SHARD A RUN, ACROSS A PERSISTENT POOL — the same runs the serial fold
+/// walks, and in the same order, so the fold that follows is the serial one to
+/// the bit.  An atomic index gives the next free worker the next run; the
+/// result vector is filled by index, so only WHERE a run was fought changes,
+/// never the order the shards are merged.
+///
+/// A RUN THAT PANICS IS A `RunFailure`, NOT A DEAD PROCESS: the first failing
+/// index, in run order, is the one returned, so the answer is deterministic.
+#[cfg(not(target_arch = "wasm32"))]
+fn shards_with<F>(
+    fight: F,
+    from: u32,
+    count: u32,
+    seed: u64,
+    threads: usize,
+) -> Result<Vec<Shard>, RunFailure>
+where
+    F: Fn(u32, u64) -> Shard + Send + Sync + 'static,
+{
+    let n = count as usize;
+    let lanes = threads.max(1).min(n.max(1));
+    if lanes <= 1 {
+        let mut out = Vec::with_capacity(n);
+        for i in 0..n {
+            let run = from + i as u32;
+            out.push(fight_guarded(&fight, run, from, count, seed)?);
+        }
+        return Ok(out);
+    }
+    let fight = Arc::new(fight);
+    let next = Arc::new(AtomicUsize::new(0));
+    let (tx, rx) = mpsc::channel::<Vec<(usize, Result<Shard, RunFailure>)>>();
+    let pool = pool_for(lanes);
+    for _ in 0..lanes {
+        let fight = Arc::clone(&fight);
+        let next = Arc::clone(&next);
+        let tx = tx.clone();
+        pool.submit(Box::new(move || {
+            let mut found = Vec::new();
+            loop {
+                let i = next.fetch_add(1, Ordering::Relaxed);
+                if i >= n {
+                    break;
+                }
+                let run = from + i as u32;
+                found.push((i, fight_guarded(fight.as_ref(), run, from, count, seed)));
+            }
+            let _ = tx.send(found);
+        }));
+    }
+    drop(tx);
+    let mut out: Vec<Option<Result<Shard, RunFailure>>> = (0..n).map(|_| None).collect();
+    for _ in 0..lanes {
+        match rx.recv() {
+            Ok(batch) => {
+                for (i, s) in batch {
+                    out[i] = Some(s);
+                }
+            }
+            // Every lane's sender is gone without a batch: a run whose shard
+            // never arrived is not an answer, so the fold fails on it.
+            Err(_) => break,
+        }
+    }
+    let mut got = Vec::with_capacity(n);
+    for (i, slot) in out.into_iter().enumerate() {
+        match slot {
+            Some(Ok(s)) => got.push(s),
+            Some(Err(e)) => return Err(e),
+            None => {
+                return Err(RunFailure {
+                    from,
+                    count,
+                    run: from + i as u32,
+                    seed,
+                    message: "a lane returned no shard".to_string(),
+                })
+            }
+        }
+    }
+    Ok(got)
+}
+
+/// …AND THE SAME, SERIAL, where there are no threads to have.  A run's panic is
+/// caught here too, so the wasm build answers the same way.
+#[cfg(target_arch = "wasm32")]
+fn shards_with<F>(
+    fight: F,
+    from: u32,
+    count: u32,
+    seed: u64,
+    _threads: usize,
+) -> Result<Vec<Shard>, RunFailure>
+where
+    F: Fn(u32, u64) -> Shard,
+{
+    let n = count as usize;
+    let mut out = Vec::with_capacity(n);
+    for i in 0..n {
+        let run = from + i as u32;
+        out.push(fight_guarded(&fight, run, from, count, seed)?);
+    }
+    Ok(out)
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub fn shards_parallel(
+    params: Arc<FightParams>,
+    from: u32,
+    count: u32,
+    seed: u64,
+    keep: bool,
+    threads: usize,
+) -> Result<Vec<Shard>, RunFailure> {
+    let fight = move |run: u32, seed: u64| {
+        shard(params.as_ref(), run, 1, seed, keep, &mut |_| {})
+    };
+    shards_with(fight, from, count, seed, threads)
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn shards_parallel(
+    params: Arc<FightParams>,
+    from: u32,
+    count: u32,
+    seed: u64,
+    keep: bool,
+    _threads: usize,
+) -> Result<Vec<Shard>, RunFailure> {
+    let fight = move |run: u32, seed: u64| shard(params.as_ref(), run, 1, seed, keep, &mut |_| {});
+    shards_with(fight, from, count, seed, 1)
+}
+
+/// …AND THE FOLD, THREADED: fight the runs in parallel and add each one AS IT
+/// ARRIVES, in RUN ORDER.  Floating-point addition is not associative, so the
+/// order the marginals are added in is part of the answer — and it is the one
+/// `shard_onto` uses: run 0, then run 1, … then run `count-1`.  One lane is
+/// `shard_onto` itself.
+///
+/// WHAT CHANGED IS WHEN THE SHARDS EXIST.  This used to fight all `count` runs
+/// into a `Vec<Shard>` and only then add them, so a row kept a thousand shards
+/// (megabytes) alive for the whole fight and the addition could not start
+/// until the last run had finished.  Here a lane builds ONE SHARD PER RUN,
+/// hands over a chunk of them, and goes straight back to fighting; the calling
+/// thread (the merger) adds each chunk the moment every run before it has
+/// arrived.  Peak shards drop from `count` to a couple of chunks per lane, and
+/// the additions overlap the fight instead of following it.
+///
+/// THE ADDITIONS THEMSELVES ARE UNTOUCHED: same values, same order, one run at
+/// a time.  A lane's shard is that run's own contribution, never a
+/// partly-summed one, because summing inside a lane would reassociate the
+/// additions and change the last bits of every answer.
+///
+/// AND A PANICKING RUN FAILS THE FOLD INSTEAD OF THE PROCESS: the run is caught
+/// in its lane, the merger returns that `RunFailure`, and no chunk after it is
+/// added.
+#[cfg(not(target_arch = "wasm32"))]
+fn fold_with<F>(
+    fight: F,
+    acc: Shard,
+    from: u32,
+    count: u32,
+    seed: u64,
+    threads: usize,
+) -> Result<Shard, RunFailure>
+where
+    F: Fn(u32, u64) -> Shard + Send + Sync + 'static,
+{
+    let n = count as usize;
+    let lanes = threads.max(1).min(n.max(1));
+    let mut acc = acc;
+    if lanes <= 1 {
+        for i in 0..n {
+            let run = from + i as u32;
+            acc.merge(&fight_guarded(&fight, run, from, count, seed)?);
+        }
+        if phase_trace() {
+            eprintln!("PHASE fold lanes=1 count={n} serial=1 chunks=0 peak_inflight=0 \
+shard_bytes={}", n * std::mem::size_of::<Shard>());
+        }
+        return Ok(acc);
+    }
+    let chunk = chunk_for(n, lanes);
+    let chunks = (n + chunk - 1) / chunk;
+    // METERING IS OFF THE HOT PATH: `trace` is read once per row, and with the
+    // flag down the lanes and the merger do not touch the counters at all.
+    let trace = phase_trace();
+    if trace {
+        foldstats::reset();
+    }
+    // HOW FAR A LANE MAY RUN AHEAD OF THE MERGER, in chunks.  Without a limit
+    // a lane that draws fast runs would pile up shards the merger cannot use
+    // yet; with it, the shards in flight stay at a couple of chunks a lane.
+    let ahead = lanes * 2;
+    let fight = Arc::new(fight);
+    let assign = Arc::new(AtomicUsize::new(0));
+    let cursor = Arc::new(AtomicUsize::new(0));
+    let (tx, rx) = mpsc::channel::<(usize, Result<Vec<Shard>, RunFailure>)>();
+    let pool = pool_for(lanes);
+    for _ in 0..lanes {
+        let fight = Arc::clone(&fight);
+        let assign = Arc::clone(&assign);
+        let cursor = Arc::clone(&cursor);
+        let tx = tx.clone();
+        pool.submit(Box::new(move || loop {
+            let c = assign.fetch_add(1, Ordering::Relaxed);
+            if c >= chunks {
+                break;
+            }
+            while c > cursor.load(Ordering::Acquire) + ahead {
+                std::thread::yield_now();
+            }
+            let lo = c * chunk;
+            let hi = (lo + chunk).min(n);
+            let mut got = Vec::with_capacity(hi - lo);
+            let mut failed = None;
+            for i in lo..hi {
+                let run = from + i as u32;
+                match fight_guarded(fight.as_ref(), run, from, count, seed) {
+                    Ok(s) => got.push(s),
+                    Err(e) => {
+                        failed = Some(e);
+                        break;
+                    }
+                }
+            }
+            let payload = match failed {
+                Some(e) => Err(e),
+                None => {
+                    if trace {
+                        foldstats::produced((hi - lo) as u64);
+                    }
+                    Ok(got)
+                }
+            };
+            if tx.send((c, payload)).is_err() {
+                break;
+            }
+        }));
+    }
+    drop(tx);
+    let mut held: Vec<Option<Result<Vec<Shard>, RunFailure>>> =
+        (0..chunks).map(|_| None).collect();
+    let mut expect = 0usize;
+    while expect < chunks {
+        match rx.recv() {
+            Ok((c, got)) => {
+                held[c] = Some(got);
+                // ADD EVERYTHING THAT IS NOW IN ORDER — run by run, exactly as
+                // the serial fold would have added it.
+                while expect < chunks {
+                    match held[expect].take() {
+                        Some(Ok(batch)) => {
+                            for s in &batch {
+                                acc.merge(s);
+                            }
+                            if trace {
+                                foldstats::merged(batch.len() as u64);
+                            }
+                            expect += 1;
+                            cursor.store(expect, Ordering::Release);
+                        }
+                        // A CHUNK WITH A PANICKING RUN ENDS THE FOLD THERE.  The
+                        // runs before it are already added, the ones after it
+                        // never will be, and the caller gets the run that broke.
+                        Some(Err(e)) => return Err(e),
+                        None => break,
+                    }
+                }
+            }
+            // Every lane's sender is gone: an answer built from a row that lost
+            // runs would be silently wrong, so the fold fails on the first run
+            // it never got.
+            Err(_) => {
+                return Err(RunFailure {
+                    from,
+                    count,
+                    run: from + (expect * chunk) as u32,
+                    seed,
+                    message: "the fold's lanes stopped before every run arrived".to_string(),
+                })
+            }
+        }
+    }
+    if trace {
+        let (produced, merged_n, peak) = foldstats::snapshot();
+        eprintln!(
+            "PHASE fold lanes={lanes} count={n} chunk={chunk} chunks={chunks} \
+produced={produced} merged={merged_n} peak_inflight={peak} shard_bytes={}",
+            n * std::mem::size_of::<Shard>());
+    }
+    Ok(acc)
+}
+
+/// …AND THE SAME FOLD, SERIAL, where there are no threads to have.
+#[cfg(target_arch = "wasm32")]
+fn fold_with<F>(
+    fight: F,
+    acc: Shard,
+    from: u32,
+    count: u32,
+    seed: u64,
+    _threads: usize,
+) -> Result<Shard, RunFailure>
+where
+    F: Fn(u32, u64) -> Shard,
+{
+    let mut acc = acc;
+    for i in 0..count as usize {
+        let run = from + i as u32;
+        acc.merge(&fight_guarded(&fight, run, from, count, seed)?);
+    }
+    Ok(acc)
+}
+
+pub fn fold_parallel(
+    params: Arc<FightParams>,
+    acc: Shard,
+    from: u32,
+    count: u32,
+    seed: u64,
+    keep: bool,
+    threads: usize,
+) -> Result<Shard, RunFailure> {
+    let fight = move |run: u32, seed: u64| {
+        shard(params.as_ref(), run, 1, seed, keep, &mut |_| {})
+    };
+    fold_with(fight, acc, from, count, seed, threads)
+}
+
+
+impl Shard {
+    /// TURN THE CONTRIBUTIONS INTO THE ANSWER. Everything below divides by the
+    /// run count, which is why none of it can live in the shard.
+    pub fn finish(self, params: &FightParams, _runs: u32) -> (Summary, RunSeries) {
+        let runs = self.runs;
+        let work = self.work();
+        let series = self.series.clone();
+        let (sum, sum_sq, min, max) = (self.sum, self.sum_sq, self.min, self.max);
+        let (effective, effective_sq, dot) = (self.effective, self.effective_sq, self.dot);
+        let (overkill, spilled) = (self.overkill, self.spilled);
+        let (health_damage, virus_stack_health) = (self.health_damage, self.virus_stack_health);
+        let armor_left_health = self.armor_left_health;
+        let (procs, field_ticks, reloads, transforms) =
+            (self.procs, self.field_ticks, self.reloads, self.transforms);
+        let picked_up_ammo = self.picked_up_ammo;
+        let (ghost_kills, ghosts_peak) = (self.ghost_kills, self.ghosts_peak);
+        let dot_ticks = self.dot_ticks;
+        let (kills, kills_sq) = (self.kills, self.kills_sq);
+        let (kill_progress, kill_progress_sq) = (self.kill_progress, self.kill_progress_sq);
+        let (min_kills, max_kills) = (self.min_kills, self.max_kills);
+        let (downtime, first_magazine, max_hit_sum, biggest) =
+            (self.downtime, self.first_magazine, self.max_hit_sum, self.biggest);
+        // A PERCENTILE OVER WHAT ACTUALLY HAPPENED. Sorted here rather than by
+        // the caller: an unsorted percentile is a number that looks right. It
+        // is also why the shard carries the raw list — a merge cannot recover a
+        // percentile from two of them.
+        let mut ttks = self.ttks.clone();
+        ttks.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+        let pct = |v: &[f64], q: f64| -> f64 {
+            if v.is_empty() {
+                return 0.0;
+            }
+            let i = ((v.len() as f64 - 1.0) * q).round() as usize;
+            v[i.min(v.len() - 1)]
+        };
+        let (shots, pellets, crits, big_crits) =
+            (self.shots, self.pellets, self.crits, self.big_crits);
+        let (crit_tier_sum, headshots) = (self.crit_tier_sum, self.headshots);
+        let sources = self.sources;
+        let mut mean_damage_by_body = BodyDamage::default();
+        let mut mean_damage_by_combatant = CombatantDamage::default();
+        if runs > 0 {
+            for (acc, v) in mean_damage_by_body.0.iter_mut().zip(&self.by_body) {
+                *acc = v / f64::from(runs);
+            }
+            for (acc, v) in mean_damage_by_combatant.0.iter_mut().zip(&self.by_combatant) {
+                *acc = v / f64::from(runs);
+            }
+        }
+
+        let n = runs.max(1) as f64;
+        let mean = sum / n;
+        let variance = (sum_sq / n - mean * mean).max(0.0);
+        let total_pellets = pellets.max(1) as f64;
+        let total_shots = shots;
+    let summary = Summary {
+        mean_damage_by_body,
+        mean_damage_by_combatant,
+        by_seat: self.seat_counters,
+        runs,
+        work,
+        duration_seconds: params.duration_seconds,
+        mean_damage: mean,
+        dps: mean / params.duration_seconds,
+        std_damage: variance.sqrt(),
+        min_damage: if min.is_finite() { min } else { 0.0 },
+        max_damage: if max.is_finite() { max } else { 0.0 },
+        mean_effective_damage: effective / n,
+        std_effective_damage: {
+            let mean_e = effective / n;
+            (effective_sq / n - mean_e * mean_e).max(0.0).sqrt()
+        },
+        effective_dps: effective / n / params.duration_seconds,
+        mean_dot_damage: dot / n,
+        mean_overkill: overkill / n,
+        mean_spilled: spilled / n,
+        mean_health_damage: health_damage / n,
+        // THE RATIO OF THE SUMS, never the mean of the ratios: a run that
+        // reached health once and a run that reached it ten thousand times
+        // are not one vote each.
+        mean_virus_stacks: if health_damage > 0.0 {
+            virus_stack_health / health_damage
+        } else {
+            0.0
+        },
+        mean_armor_left: if health_damage > 0.0 {
+            armor_left_health / health_damage
+        } else {
+            1.0
+        },
+        mean_procs: procs as f64 / n,
+        mean_field_ticks: field_ticks as f64 / n,
+        mean_dot_ticks: dot_ticks as f64 / n,
+        mean_reloads: reloads as f64 / n,
+        mean_picked_up_ammo: picked_up_ammo / n,
+        mean_transforms: transforms as f64 / n,
+        mean_ghosts: ghost_kills as f64 / n,
+        ghosts_peak,
+        mean_kills: kills as f64 / n,
+        std_kills: {
+            let mean_k = kills as f64 / n;
+            (kills_sq as f64 / n - mean_k * mean_k).max(0.0).sqrt()
+        },
+        min_kills: if min_kills == u32::MAX { 0 } else { min_kills },
+        max_kills,
+        mean_kill_progress: kill_progress / n,
+        std_kill_progress: {
+            let mean_kp = kill_progress / n;
+            (kill_progress_sq / n - mean_kp * mean_kp).max(0.0).sqrt()
+        },
+        mean_shots: shots as f64 / n,
+        mean_pellets: pellets as f64 / n,
+        mean_crit_rate: crits as f64 / total_pellets,
+        mean_big_crit_rate: big_crits as f64 / total_pellets,
+        mean_self_damage: self.self_damage.scale(1.0 / runs.max(1) as f64),
+        mean_crit_tier: crit_tier_sum as f64 / total_pellets,
+        mean_headshot_rate: headshots as f64 / total_pellets,
+        burst_dps: {
+            // The time the weapon was NOT reloading, across every run. Guarded
+            // at a hundredth of a second: a run that was reloading the whole
+            // time has no burst to report and must not report infinity.
+            let firing = (params.duration_seconds * runs as f64 - downtime).max(1e-2);
+            effective / firing
+        },
+        mean_downtime_seconds: downtime / runs as f64,
+        ttk_mean: if ttks.is_empty() { 0.0 } else { ttks.iter().sum::<f64>() / ttks.len() as f64 },
+        ttk_median: pct(&ttks, 0.5),
+        ttk_p90: pct(&ttks, 0.9),
+        ttk_runs: ttks.len() as u32,
+        mean_first_magazine: first_magazine / runs as f64,
+        max_hit: biggest,
+        mean_max_hit: max_hit_sum / runs as f64,
+        damage_per_shot: effective / (total_shots as f64).max(1.0),
+        damage_per_pellet: effective / total_pellets,
+        source_damage: {
+            let mut s = sources;
+            s.direct /= n;
+            s.radial /= n;
+            s.field /= n;
+            s.arcane_on_status /= n;
+            for v in s.status.iter_mut() {
+                *v /= n;
+            }
+            s
+        },
+        // THE BENCHMARK FIGHT, REPLAYED. The shard carries one `(value,
+        // rng_state)` pair per run rather than the runs themselves — 16 bytes
+        // against 8 KB — so ranking them here and re-running the winner is
+        // exact and costs one extra engagement per simulation. A tie breaks on
+        // the state, so the pick cannot depend on the order shards merged in.
+        median_run: {
+            let mut idx = self.index;
+            idx.sort_by(|a, b| a.v.total_cmp(&b.v).then(a.state().cmp(&b.state())));
+            match idx.get(idx.len() / 2) {
+                Some(k) => run_once(params, &mut Rng::new(k.state())),
+                None => RunResult::default(),
+            }
+        },
+    };
+        (summary, series)
+    }
+}
