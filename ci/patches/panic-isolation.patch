+#[cfg(test)]
+mod panic_isolation {
+    use super::*;
+
+    /// A PANIC NO LONGER ABORTS THE ENGINE — the profile must inherit `unwind`.
+    #[test]
+    fn the_build_unwinds() {
+        assert!(
+            panic_isolation(),
+            "a `panic = \"abort\"` build cannot answer for a failed run"
+        );
+    }
+
+    /// A PANICKING RUN FAILS ITS FOLD, AND THE NEXT FOLD STILL RUNS: the panic
+    /// is caught in the run, so the lanes are there for the next request.
+    #[test]
+    fn a_panicking_run_fails_its_fold_and_the_lanes_survive() {
+        let boom = |run: u32, _seed: u64| -> Shard {
+            if run == 3 {
+                panic!("run 3 is bad on purpose");
+            }
+            Shard::default()
+        };
+        let err = fold_with(boom, Shard::default(), 2, 8, 7, 1)
+            .expect_err("a panicking run must fail the fold");
+        assert_eq!(err.run, 3);
+        assert_eq!((err.from, err.count, err.seed), (2, 8, 7));
+        assert!(err.message.contains("bad on purpose"), "{err}");
+
+        // AND THE SECOND ONE IS ITSELF: the panic did not poison the lanes.
+        let again = fold_with(boom, Shard::default(), 2, 8, 7, 1);
+        assert_eq!(again.expect_err("still bad").run, 3);
+    }
+
+    /// THE SAME RUN, ACROSS THE LANES: one bad run inside a chunked fold fails
+    /// the fold with THAT run and nothing after it is merged.
+    #[test]
+    fn a_panicking_run_fails_the_laned_fold() {
+        let boom = |run: u32, _seed: u64| -> Shard {
+            if run == 13 {
+                panic!("thirteen");
+            }
+            Shard::default()
+        };
+        let err = fold_with(boom, Shard::default(), 0, 64, 11, 4)
+            .expect_err("a panicking run must fail the laned fold");
+        assert_eq!(err.run, 13);
+        assert_eq!(err.message, "thirteen");
+    }
+
+    /// …AND THE SHARD-GATHERING PATH TOO, so `/api/board/runs` cannot die either.
+    #[test]
+    fn a_panicking_run_fails_the_shards() {
+        let boom = |run: u32, _seed: u64| -> Shard {
+            if run == 5 {
+                panic!("five");
+            }
+            Shard::default()
+        };
+        let err =
+            shards_with(boom, 0, 16, 3, 1).expect_err("a panicking run must fail the shards");
+        assert_eq!(err.run, 5);
+        assert_eq!(err.message, "five");
+    }
+}
