-/// Is the phase trace on?  Read ONCE — a row must not pay a getenv for it.
-fn phase_trace() -> bool {
-    static ON: OnceLock<bool> = OnceLock::new();
-    *ON.get_or_init(|| std::env::var_os("WFSIM_PHASE_TRACE").is_some())
-}
